+        .frame(height: gridHeight)
+      case 4:
+        VStack(spacing: 4) {
+          HStack(spacing: 4) {
+            makeCell(for: 0)
+            makeCell(for: 1)
+          }
+          HStack(spacing: 4) {
+            makeCell(for: 2)
+            makeCell(for: 3)
+          }
+        }
+        .frame(height: gridHeight)
+      default:
+        HStack(alignment: .top, spacing: 4) {
