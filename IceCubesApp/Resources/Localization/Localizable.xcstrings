    "explore.search.message-%@": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u044d\u043a\u0440\u0430\u043d\u0430 \u0432\u044b \u043c\u043e\u0436\u0430\u0446\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0448\u0442\u043e \u0437\u0430\u045e\u0433\u043e\u0434\u043d\u0430 \u043d\u0430 %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Des d'aquest apartat podeu cercar qualsevol cosa a %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kannst du alles auf %@ suchen"
          }
        },
        "en": {
          "stringUnit": {
