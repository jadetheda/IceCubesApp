        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\uac00 \ubcf8 \uac8c\uc2dc\ubb3c\uc744 \uc790\ub3d9\uc73c\ub85c \ucd94\uc801\ud558\uace0 \ud0c0\uc784\ub77c\uc778\uc5d0\uc11c \uc228\uae38 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor automatisk hvilke innlegg du har sett, og tillat \u00e5 skjule dem fra tidslinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg automatisch welke berichten je hebt gezien en maak het mogelijk om ze te verbergen in de tijdlijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie \u015bled\u017a przeczytane wpisy i zezwalaj na ukrywanie ich z osi czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreie automaticamente quais posts voc\u00ea j\u00e1 viu e permita ocult\u00e1-los da linha do tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi g\u00f6nderileri g\u00f6rd\u00fc\u011f\u00fcn\u00fcz\u00fc otomatik olarak izleyin ve zaman t\u00fcnelinden gizlenmelerine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0439\u0442\u0435, \u044f\u043a\u0456 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0432\u0438 \u0431\u0430\u0447\u0438\u043b\u0438, \u0442\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0439\u0442\u0435 \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u0437\u0456 \u0441\u0442\u0440\u0456\u0447\u043a\u0438."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52a8\u8ffd\u8e2a\u4f60\u5df2\u770b\u8fc7\u7684\u5e16\u5b50\uff0c\u5e76\u5141\u8bb8\u5728\u65f6\u95f4\u7ebf\u4e2d\u5c06\u5176\u9690\u85cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52d5\u8ffd\u8e64\u4f60\u5df2\u770b\u904e\u7684\u8cbc\u6587\uff0c\u4e26\u5141\u8a31\u5728\u6642\u9593\u8ef8\u4e2d\u5c07\u5176\u96b1\u85cf\u3002"
          }
        }
      }
    },
    "settings.content.timeline.gallery-toggle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u044c\u043d\u0456\u043a \u0440\u044d\u0436\u044b\u043c\u0443 \u0433\u0430\u043b\u0435\u0440\u044d\u0456 \u045e \u043c\u0435\u043d\u044e \u0441\u0442\u0443\u0436\u043a\u0456"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Commutador de mode galeria al men\u00fa de la cronologia"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Galeriemodus-Schalter im Timeline-Men\u00fc"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show \"Gallery Mode\" in filter menu"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Show \"Gallery Mode\" in filter menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interruptor de modo galer\u00eda en el men\u00fa de la cronolog\u00eda"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Galeria moduko aldatzailea denbora-lerroko menuan"
