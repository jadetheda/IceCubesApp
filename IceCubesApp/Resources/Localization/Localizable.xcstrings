    "An error occured while posting to Mastodon, please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler ist beim Ver\u00f6ffentlichen auf Mastodon aufgetreten, bitte versuch es noch mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ocurrido un error al publicar en Mastodon, por favor int\u00e9ntalo de nuevo."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Errorea gertatu da Mastodonen argitaratzean, saiatu berriro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors de la publication sur Mastodon, veuillez r\u00e9essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si \u00e8 verificato un errore durante la pubblicazione su Mastodon, riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae00\uc744 \uac8c\uc2dc\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574\uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden tijdens het plaatsen van het bericht op Mastodon, probeer het nogmaals."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um erro ocorreu ao postar no Mastodon, por favor, tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastodon'a g\u00f6nderim yap\u0131l\u0131rken bir hata olu\u015ftu, l\u00fctfen tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5411 Mastodon \u53d1\u8868\u561f\u6587\u65f6\u51fa\u9519\uff0c\u8bf7\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 Mastodon \u4e0a\u767c\u8868\u6642\u767c\u751f\u932f\u8aa4\uff0c\u8acb\u7a0d\u5f85\u91cd\u8a66\u3002"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyst\u0105pi\u0142 b\u0142\u0105d podczas publikowania na Mastodonie, spr\u00f3buj ponownie."
          }
        }
      }
    },
