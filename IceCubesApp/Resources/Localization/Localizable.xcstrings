            "value": "\u4e32\u6d41\u4e3b\u9801\u6642\u9593\u8ef8"
          }
        }
      }
    },
    "settings.experimental.stream-home.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u044b\u043c\u0430\u0435 \u0432\u0430\u0448\u0443 \u0445\u0430\u0442\u043d\u044e\u044e \u0441\u0442\u0443\u0436\u043a\u0443 \u045e \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c \u0441\u0442\u0430\u043d\u0435 \u045e \u0440\u044d\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u0430\u0441\u0435 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u0456\u043d\u0433\u0443, \u043a\u0430\u043b\u0456 \u0451\u043d \u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b. \u0410\u0434\u043a\u043b\u044e\u0447\u044b\u0446\u0435 \u043f\u0440\u044b \u043f\u0440\u0430\u0431\u043b\u0435\u043c\u0430\u0445 \u0437 \u043f\u0440\u0430\u0434\u0443\u043a\u0446\u044b\u0439\u043d\u0430\u0441\u0446\u044e."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9 la cronologia d'inici actualitzada en temps real mitjan\u00e7ant la transmissi\u00f3 quan estigui disponible. Desactiveu-la en cas de problemes de rendiment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4lt deine Home-Timeline bei Verf\u00fcgbarkeit per Streaming in Echtzeit aktuell. Bei Performance-Problemen deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your home timeline up to date in real time using streaming. Disable if you experience performance issues."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your home timeline up to date in real time using streaming. Disable if you experience performance issues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tu cronolog\u00eda de inicio actualizada en tiempo real mediante transmisi\u00f3n cuando est\u00e9 disponible. Desact\u00edvalo en caso de problemas de rendimiento."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Etxeko denbora-lerroa denbora errealean eguneratuta mantentzen du streaming bidez erabilgarri dagoenean. Desgaitu errendimendu arazoak izanez gero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient votre fil d'accueil \u00e0 jour en temps r\u00e9el \u00e0 l'aide du flux de streaming disponible. D\u00e9sactiver en cas de probl\u00e8mes de performances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la cronologia Home aggiornata in tempo reale tramite streaming se disponibile. Disattiva in caso di problemi di prestazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u304c\u5229\u7528\u53ef\u80fd\u306a\u5834\u5408\u3001\u30db\u30fc\u30e0\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u3092\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u6700\u65b0\u306e\u72b6\u614b\u306b\u4fdd\u3061\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u554f\u984c\u304c\u3042\u308b\u5834\u5408\u306f\u7121\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac00\ub2a5\ud55c \uacbd\uc6b0 \uc2a4\ud2b8\ub9ac\ubc0d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud648 \ud0c0\uc784\ub77c\uc778\uc744 \uc2e4\uc2dc\uac04\uc73c\ub85c \ucd5c\uc2e0 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc131\ub2a5 \ubb38\uc81c\uac00 \uc788\ub294 \uacbd\uc6b0 \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder hjemmetidslinjen oppdatert i sanntid ved bruk av str\u00f8mming n\u00e5r tilgjengelig. Deaktiver ved ytelsesproblemer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt je home-tijdlijn in realtime up-to-date via streaming indien beschikbaar. Schakel dit uit bij prestatieproblemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje g\u0142\u00f3wn\u0105 o\u015b czasu w czasie rzeczywistym, korzystaj\u0105c ze strumieniowania, gdy jest dost\u0119pne. Wy\u0142\u0105cz w przypadku problem\u00f3w z wydajno\u015bci\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9m sua linha do tempo inicial atualizada em tempo real usando streaming quando dispon\u00edvel. Desative em caso de problemas de desempenho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullan\u0131labilir oldu\u011funda ak\u0131\u015f kullanarak ana sayfa zaman t\u00fcnelinizi ger\u00e7ek zamanl\u0131 olarak g\u00fcncel tutar. Performans sorunlar\u0131 olmas\u0131 durumunda devre d\u0131\u015f\u0131 b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0438\u043c\u0430\u0454 \u0432\u0430\u0448\u0443 \u0441\u0442\u0440\u0456\u0447\u043a\u0443 \u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0441\u0442\u0440\u0456\u043c\u0456\u043d\u0433\u0443, \u044f\u043a\u0449\u043e \u0432\u0456\u043d \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439. \u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c \u0443 \u0440\u0430\u0437\u0456 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0456\u0437 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044e."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u53ef\u7528\u65f6\u901a\u8fc7\u6d41\u5f0f\u4f20\u8f93\u5b9e\u65f6\u66f4\u65b0\u4f60\u7684\u4e3b\u9875\u65f6\u95f4\u7ebf\u3002\u82e5\u9047\u5230\u6027\u80fd\u95ee\u9898\u8bf7\u7981\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u53ef\u7528\u6642\u900f\u904e\u4e32\u6d41\u5373\u6642\u66f4\u65b0\u4f60\u7684\u4e3b\u9801\u6642\u9593\u8ef8\u3002\u82e5\u9047\u5230\u6548\u80fd\u554f\u984c\u8acb\u505c\u7528\u3002"
          }
        }
      }
    },
