        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u306e\u30ae\u30e3\u30e9\u30ea\u30fc\u30e2\u30fc\u30c9\u30c8\u30b0\u30eb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0c0\uc784\ub77c\uc778 \uba54\ub274\uc758 \uac24\ub7ec\ub9ac \ubaa8\ub4dc \ud1a0\uae00"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryter for gallerimodus i tidslinjemenuen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Galeriemodus-schakelaar in tijdlijnmenu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cznik trybu galerii w menu osi czasu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternador de Modo Galeria no Menu da Linha do Tempo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman T\u00fcneli Men\u00fcs\u00fcnde Galeri Modu Se\u00e7ici"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u0440\u0435\u0436\u0438\u043c\u0443 \u0433\u0430\u043b\u0435\u0440\u0435\u0457 \u0432 \u043c\u0435\u043d\u044e \u0441\u0442\u0440\u0456\u0447\u043a\u0438"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65f6\u95f4\u7ebf\u83dc\u5355\u4e2d\u7684\u753b\u5eca\u6a21\u5f0f\u5f00\u5173"
          }
        },
        "zh-Hant": {
          "stringUnit": {
