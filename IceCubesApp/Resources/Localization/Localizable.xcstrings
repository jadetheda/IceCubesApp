      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u043f\u0430\u0434\u0432\u043e\u0435\u043d\u044b\u044f \u0430\u043f\u0430\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0456? \u041f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u0439 \u0433\u044d\u0442\u0443\u044e \u0447\u0430\u0440\u043e\u045e\u043d\u0443\u044e \u043a\u043d\u043e\u043f\u043a\u0443 \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c"
