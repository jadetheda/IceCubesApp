        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\uc758\ud558\uc138\uc694: \ucf58\ud150\uce20 \uc124\uc815\uc774 \uc774 \uc124\uc815\uc744 \ub36e\uc5b4\uc4f0\uace0 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc774 \uc124\uc815\uc740 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
