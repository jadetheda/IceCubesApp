    "settings.experimental.full-timeline-fetch.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435 \u045e\u0441\u0435 \u043d\u043e\u0432\u044b\u044f \u043f\u0430\u0441\u0442\u044b (\u0434\u0430 800) \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u043f\u043e\u0448\u043d\u0456\u0445 40 + \u0440\u0443\u0447\u043d\u043e\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0456 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0443."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera totes les publicacions noves de la cronologia (fins a 800) en lloc de nom\u00e9s les darreres 40 + carregar manualment el buit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft alle neuen Timeline-Beitr\u00e4ge ab (bis zu 800) anstatt nur die neuesten 40 + manuelles Laden der L\u00fccke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches all new timeline posts (up to 800) at once, instead of fetching the latest 40 and requiring you to manually load the gap."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches all new timeline posts (up to 800) at once, instead of fetching the latest 40 and requiring you to manually load the gap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera todas las publicaciones nuevas de la cronolog\u00eda (hasta 800) en lugar de solo las \u00faltimas 40 + cargar manualmente el hueco."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Denbora-lerroko mezu berri guztiak berreskuratzen ditu (800 arte) azken 40ak soilik jaso eta hutsunea eskuz kargatu beharrean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9cup\u00e8re tous les nouveaux messages du fil (jusqu'\u00e0 800) au lieu de seulement les 40 derniers + chargement manuel de l'\u00e9cart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera tutti i nuovi post della cronologia (fino a 800) invece di scaricare solo gli ultimi 40 e caricare manualmente il gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u65b0\u306e40\u4ef6\u306e\u307f\u3092\u53d6\u5f97\u3057\u3066\u30ae\u30e3\u30c3\u30d7\u3092\u624b\u52d5\u3067\u8aad\u307f\u8fbc\u3080\u4ee3\u308f\u308a\u306b\u3001\u3059\u3079\u3066\u306e\u65b0\u3057\u3044\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u6295\u7a3f\uff08\u6700\u5927800\u4ef6\uff09\u3092\u53d6\u5f97\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd5c\uc2e0 40\uac1c\ub9cc \uac00\uc838\uc624\uace0 \uac2d\uc744 \uc218\ub3d9\uc73c\ub85c \ub85c\ub4dc\ud558\ub294 \ub300\uc2e0 \uc0c8\ub85c\uc6b4 \ud0c0\uc784\ub77c\uc778 \uac8c\uc2dc\ubb3c \uc804\uccb4(\ucd5c\ub300 800\uac1c)\ub97c \uac00\uc838\uc635\ub2c8\ub2e4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter alle nye tidslinjeinnlegg (opptil 800) i stedet for kun de siste 40 + manuelt laste inn gapet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt alle nieuwe tijdlijnberichten op (tot 800) in plaats van alleen de nieuwste 40 + handmatig het gat laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera wszystkie nowe wpisy z osi czasu (do 800) zamiast tylko ostatnich 40 + r\u0119cznego \u0142adowania luki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca todos os novos posts da linha do tempo (at\u00e9 800) em vez de apenas os \u00faltimos 40 + carregar manualmente o intervalo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca en son 40 g\u00f6nderiyi al\u0131p bo\u015flu\u011fu manuel olarak y\u00fcklemek yerine t\u00fcm yeni zaman t\u00fcneli g\u00f6nderilerini (800e kadar) al\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u043d\u043e\u0432\u0456 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0441\u0442\u0440\u0456\u0447\u043a\u0438 (\u0434\u043e 800) \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u043b\u0438\u0448\u0435 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0445 40 + \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0433\u0430\u043b\u0438\u043d\u0438."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u83b7\u53d6\u6240\u6709\u65b0\u7684\u65f6\u95f4\u7ebf\u5e16\u5b50\uff08\u6700\u591a800\u6761\uff09\uff0c\u800c\u4e0d\u662f\u4ec5\u83b7\u53d6\u6700\u65b0\u768440\u6761+\u624b\u52a8\u52a0\u8f7d\u672a\u8bfb\u533a\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7372\u53d6\u6240\u6709\u65b0\u7684\u6642\u9593\u8ef8\u8cbc\u6587\uff08\u6700\u591a800\u689d\uff09\uff0c\u800c\u4e0d\u662f\u50c5\u7372\u53d6\u6700\u65b0\u768440\u689d+\u624b\u52d5\u8f09\u5165\u672a\u8b80\u5340\u9593\u3002"
          }
        }
      }
    },
