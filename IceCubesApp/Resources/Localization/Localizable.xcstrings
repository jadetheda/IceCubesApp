    "settings.content.hide-seen.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u045e\u0442\u0430\u043c\u0430\u0442\u044b\u0447\u043d\u0430 \u0430\u0434\u0441\u043e\u0447\u0432\u0430\u0439\u0446\u0435, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u044b \u0432\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439\u0446\u0435 \u0445\u0430\u0432\u0430\u0446\u044c \u0456\u0445 \u0441\u0430 \u0441\u0442\u0443\u0436\u043a\u0456."
