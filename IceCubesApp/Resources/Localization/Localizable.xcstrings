        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b66\u544a: \u3053\u308c\u3089\u306e\u8a2d\u5b9a\u306f\u30b0\u30ed\u30fc\u30d0\u30eb \u30b3\u30f3\u30c6\u30f3\u30c4\u8a2d\u5b9a\u306b\u3088\u3063\u3066\u4e0a\u66f8\u304d\u3055\u308c\u307e\u3059"
