    },
    "settings.content.timeline.gallery-toggle-footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0445\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b \u0431\u0435\u0437 \u043c\u0435\u0434\u044b\u044f \u0437 \u043c\u0435\u043d\u044e \u0444\u0456\u043b\u044c\u0442\u0440\u0430\u0446\u044b\u0456 \u0441\u0442\u0443\u0436\u043a\u0456."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet amagar les publicacions sense mitjans del men\u00fa de filtre de la cronologia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erm\u00f6glicht das Ausblenden von Beitr\u00e4gen ohne Medien im Timeline-Filtermen\u00fc."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a toggle to the timeline's filter menu to switch to Gallery Mode."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a toggle to the timeline's filter menu to switch to Gallery Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ocultar publicaciones sin multimedia del men\u00fa de filtro de la cronolog\u00eda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Denbora-lerroko iragazki menutik multimediarik gabeko mezuak ezkutatzea ahalbidetzen du."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de masquer les messages sans m\u00e9dia depuis le menu de filtre du fil d'actualit\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di nascondere i post senza contenuti multimediali dal menu dei filtri della cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u30d5\u30a3\u30eb\u30bf\u30fc\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30e1\u30c7\u30a3\u30a2\u306e\u306a\u3044\u6295\u7a3f\u3092\u975e\u8868\u793a\u306b\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0c0\uc784\ub77c\uc778 \ud544\ud130 \uba54\ub274\uc5d0\uc11c \ubbf8\ub514\uc5b4\uac00 \uc5c6\ub294 \uac8c\uc2dc\ubb3c\uc744 \uc228\uae38 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillater \u00e5 skjule innlegg uten medier fra tidslinjens filtermeny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt het mogelijk om berichten zonder media te verbergen in het tijdlijnfiltermenu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwala na ukrywanie wpis\u00f3w bez medi\u00f3w w menu filtr\u00f3w osi czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ocultar posts sem m\u00eddia a partir do menu de filtros da linha do tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman t\u00fcneli filtre men\u00fcs\u00fcnden medyas\u0131 olmayan g\u00f6nderilerin gizlenmesine izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0431\u0435\u0437 \u043c\u0435\u0434\u0456\u0430 \u0437 \u043c\u0435\u043d\u044e \u0444\u0456\u043b\u044c\u0442\u0440\u0430\u0446\u0456\u0457 \u0441\u0442\u0440\u0456\u0447\u043a\u0438."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u5728\u65f6\u95f4\u7ebf\u7b5b\u9009\u83dc\u5355\u4e2d\u9690\u85cf\u65e0\u5a92\u4f53\u7684\u5e16\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8a31\u5728\u6642\u9593\u8ef8\u7be9\u9078\u9078\u55ae\u4e2d\u96b1\u85cf\u7121\u5a92\u9ad4\u7684\u8cbc\u6587\u3002"
          }
        }
      }
    },
