    "DeepL couldn't be reached!\nIs the API Key correct?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL konnte nicht erreicht werden! Ist der API-Schl\u00fcssel korrekt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL couldn't be reached!\nIs the API Key correct?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1No se ha podido conectar con DeepL! \u00bfEs esta la clave de la API correcta?"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan da DeepL atzitu!\nZuzena al da API gakoa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL n'est pas joignable ! Est-ce que la cl\u00e9 d'API est correcte ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere DeepL! La chiave API \u00e8 corretta?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL\uc5d0 \uc811\uc18d\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. API \ud0a4\ub97c \uc815\ud655\ud558\uac8c \uc785\ub825\ud588\ub294\uc9c0 \ud655\uc778\ud574\uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL kan niet worden bereikt. Klopt de API-sleutel? "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conex\u00e3o com DeepL n\u00e3o foi poss\u00edvel. A chave de API est\u00e1 correta?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL'e ula\u015f\u0131lamad\u0131!\nAPI Anahtar\u0131 do\u011fru mu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u8fde\u63a5 DeepL\uff01\n\u4f60\u7684 API \u5bc6\u94a5\u662f\u6b63\u786e\u7684\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u806f\u7e6b DeepL\uff01API \u5bc6\u9470\u6b63\u78ba\u55ce\uff1f"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 nawi\u0105za\u0107 po\u0142\u0105czenia z DeepL!\nCzy klucz API jest poprawny?"
          }
        }
      }
    },
